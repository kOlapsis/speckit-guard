{
  "description": "speckit-guard: locks the acceptance tests during implementation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/lock-tests.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
